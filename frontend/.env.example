# Copy to .env.local and adjust.

# true  = load data from src/mock (current default, no backend needed)
# false = call the real backend (also uncomment the BACKEND blocks in src/api/client.js)
VITE_USE_MOCK=true

# BACKEND: base URL of the API server, without a trailing slash.
# VITE_API_BASE_URL=http://localhost:4000
