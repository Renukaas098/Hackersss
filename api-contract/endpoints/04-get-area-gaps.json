{
  "method": "GET",
  "path": "/api/areas/gaps",
  "auth": "none",
  "purpose": "Per-area report count and median price gap, for the Area Map.",
  "usedBy": [
    "Area Map"
  ],
  "notes": [
    "Areas with reportCount < threshold (5) must still be returned, but with visible=false and medianGapPct/worstMaterialId = null. Never leak the figure."
  ],
  "query": {
    "city": {
      "required": true,
      "example": "pune"
    },
    "material": {
      "required": false,
      "example": "all",
      "note": "reserved; frontend sends nothing yet"
    }
  },
  "exampleUrl": "/api/areas/gaps?city=pune",
  "response": {
    "status": 200,
    "body": {
      "cityId": "pune",
      "threshold": 5,
      "areas": [
        {
          "areaId": "pune-kothrud",
          "name": "Kothrud",
          "lat": 18.5074,
          "lng": 73.8077,
          "reportCount": 14,
          "visible": true,
          "medianGapPct": 9,
          "worstMaterialId": "newspaper"
        },
        {
          "areaId": "pune-hadapsar",
