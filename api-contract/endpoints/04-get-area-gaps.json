          "medianGapPct": 21,
          "worstMaterialId": "pet"
        },
        {
          "areaId": "pune-yerawada",
          "name": "Yerawada",
          "lat": 18.5523,
          "lng": 73.8867,
          "reportCount": 18,
          "visible": true,
          "medianGapPct": 27,
          "worstMaterialId": "ldpe_film"
        },
        {
          "areaId": "pune-kasba",
          "name": "Kasba Peth",
          "lat": 18.5196,
