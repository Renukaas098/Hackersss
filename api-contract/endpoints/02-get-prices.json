{
  "method": "GET",
  "path": "/api/prices",
  "auth": "none",
  "purpose": "Price ranges for one city, optionally filtered by material and grade. Each range carries its source, date and sample size.",
  "usedBy": [
    "Home quick lookup",
    "Price Range Board"
  ],
  "query": {
    "city": {
      "required": true,
      "example": "pune"
    },
    "material": {
      "required": false,
      "example": "pet",
      "note": "omit or 'all' for every material"
    },
    "grade": {
      "required": false,
      "example": "B",
      "note": "A | B | C, omit or 'all' for every grade"
    }
  },
  "exampleUrl": "/api/prices?city=pune&material=pet",
