{
  "method": "GET",
  "path": "/api/ngo/summary",
  "auth": "required (role ngo)",
  "purpose": "Area-level underpayment table for advocacy, worst gap first.",
  "usedBy": [
    "NGO View"
  ],
  "headers": {
    "Authorization": "Bearer <token>"
  },
  "query": {
    "city": {
      "required": true,
      "example": "pune"
    },
    "from": {
      "required": false,
      "example": "2026-05-01"
    },
    "to": {
      "required": false,
      "example": "2026-10-24"
    }
  },
  "exampleUrl": "/api/ngo/summary?city=pune&from=2026-05-01&to=2026-10-24",
  "notes": [
    "Only areas with reports >= threshold.",
    "underpaidPerTonne = round((prevailingMedian - medianOffered) * 1000)."
  ],
  "response": {
    "status": 200,
    "body": {
